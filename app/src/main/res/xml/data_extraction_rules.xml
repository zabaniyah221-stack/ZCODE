<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="zabacode_secure_keys"/>
        <exclude domain="file" path=".zabacode_keys_encrypted.json"/>
        <exclude domain="file" path=".zabacode_auth_token"/>
